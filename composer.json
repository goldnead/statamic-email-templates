{
    "name": "goldnead/statamic-email-templates",
    "description": "Statamic 6 Email Templates — CP-native, Bard-authored email templates in a shared collection, consumed optionally by statamic-automations and statamic-marketing.",
    "type": "statamic-addon",
    "license": "MIT",
    "homepage": "https://github.com/goldnead/statamic-email-templates",
    "keywords": [
        "statamic",
        "statamic-addon",
        "email",
        "templates",
        "automation"
    ],
    "authors": [
        {
            "name": "goldnead",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-email-templates/issues",
        "source": "https://github.com/goldnead/statamic-email-templates"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "statamic/cms": "^6.0"
    },
    "suggest": {
        "goldnead/statamic-automations": "Send emails from workflow nodes using templates resolved by slug",
        "goldnead/statamic-marketing": "Import existing file-based marketing templates into the shared collection"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\EmailTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\EmailTemplates\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Email Templates",
            "description": "CP-native, Bard-authored email templates in a shared collection."
        },
        "laravel": {
            "providers": [
                "Goldnead\\EmailTemplates\\EmailTemplatesServiceProvider"
            ],
            "aliases": {
                "EmailTemplates": "Goldnead\\EmailTemplates\\Facades\\EmailTemplates"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
