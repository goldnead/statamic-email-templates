includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Meldet den View-Namensraum des Addons an, den bei der Analyse kein
    # ServiceProvider anmeldet. Begruendung im Kopf der Datei.
    bootstrapFiles:
        - phpstan-bootstrap.php

    level: 5

    paths:
        - src

    # A ratchet for new code, not a mandate to rewrite what already ships.
    # Everything the baseline holds was green under the previous toolchain;
    # new findings must be fixed rather than appended to the baseline.
